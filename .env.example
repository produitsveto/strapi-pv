HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Medusa Store API — exposed to the admin (STRAPI_ADMIN_ prefix is required for client-side access)
# Used by the deal-picker custom field for the hero-product carousel on deals-homepage.
STRAPI_ADMIN_MEDUSA_URL=http://localhost:9000
STRAPI_ADMIN_MEDUSA_PUBLISHABLE_KEY=

# Storefront cache revalidation — purge le cache KV des fronts à chaque
# publish/unpublish/delete pour rendre le contenu Strapi visible immédiatement.
# Chaque secret doit matcher NUXT_STOREFRONT_WEBHOOK_SECRET du front correspondant.
#
# Plusieurs fronts (recommandé) — un tableau JSON sur une ligne :
# STOREFRONT_REVALIDATE_TARGETS=[{"name":"deals","url":"https://deals.produits-veto.com/api/revalidate","secret":"…"},{"name":"pv","url":"https://produits-veto.com/api/revalidate","secret":"…"}]
#
# Un seul front (raccourci, cumulable avec le tableau) :
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=
