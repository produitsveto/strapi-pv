{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Article de blog / conseil vétérinaire"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "titre": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "titre"
    },
    "couverture": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "especes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species",
      "mappedBy": "articles"
    },
    "races": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::breed.breed",
      "mappedBy": "articles"
    },
    "laboratoires": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::laboratory.laboratory",
      "mappedBy": "articles"
    },
    "articlesLies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    },
    "contenu": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
