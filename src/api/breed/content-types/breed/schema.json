{
  "kind": "collectionType",
  "collectionName": "breeds",
  "info": {
    "singularName": "breed",
    "pluralName": "breeds",
    "displayName": "Race",
    "description": "Race animale (Labrador, Persan…)"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "marketingBanner": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "featuredProducts": {
      "type": "component",
      "repeatable": true,
      "component": "deals.featured-product"
    },
    "parentSpecies": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::species.species"
    },
    "laboratories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::laboratory.laboratory",
      "inversedBy": "breeds"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "breeds"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
