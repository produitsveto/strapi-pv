{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Catégorie Produit",
    "description": "Catégorie produit (antiparasitaires, compléments…)"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "imagePrincipale": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "banniereMarketing": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "produitsMisEnAvant": {
      "type": "component",
      "repeatable": true,
      "component": "deals.featured-product"
    },
    "categorieGoogle": {
      "type": "string"
    },
    "categorieParente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "sousCategories"
    },
    "sousCategories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "categorieParente"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "categories"
    },
    "especes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species",
      "mappedBy": "categories"
    },
    "laboratoires": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::laboratory.laboratory",
      "mappedBy": "categories"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
