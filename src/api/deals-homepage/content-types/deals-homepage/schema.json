{
  "kind": "singleType",
  "collectionName": "deals_homepages",
  "info": {
    "singularName": "deals-homepage",
    "pluralName": "deals-homepages",
    "displayName": "DEALS - Accueil"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "heroEyebrow": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "heroTitle": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "heroDescription": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "heroCtaPrimaryLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "heroCtaPrimaryLink": { "type": "string" },
    "heroCtaSecondaryLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "heroCtaSecondaryLink": { "type": "string" },
    "heroStats": { "type": "component", "repeatable": true, "component": "deals.hero-stat", "max": 4, "pluginOptions": { "i18n": { "localized": true } } },
    "heroProducts": { "type": "component", "repeatable": true, "component": "deals.hero-product", "max": 6 },
    "trustBadges": { "type": "component", "repeatable": true, "component": "deals.trust-badge", "pluginOptions": { "i18n": { "localized": true } } },
    "newProductsTitle": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "quickFilters": { "type": "component", "repeatable": true, "component": "deals.quick-filter", "pluginOptions": { "i18n": { "localized": true } } },
    "brands": { "type": "component", "repeatable": true, "component": "deals.brand" },
    "discountBadges": { "type": "component", "repeatable": true, "component": "deals.discount-badge" },
    "presentationTitle": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "presentationBody": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "stayConnectedTitle": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "stayConnectedBody": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo", "pluginOptions": { "i18n": { "localized": true } } }
  }
}
