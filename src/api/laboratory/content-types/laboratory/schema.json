{
  "kind": "collectionType",
  "collectionName": "laboratories",
  "info": {
    "singularName": "laboratory",
    "pluralName": "laboratories",
    "displayName": "Laboratoire",
    "description": "Laboratoire / Marque (Virbac, Elanco…)"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "imagePrincipale": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "banniereMarketing": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "produitsMisEnAvant": {
      "type": "component",
      "repeatable": true,
      "component": "deals.featured-product"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "laboratoires"
    },
    "especes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species",
      "mappedBy": "laboratoires"
    },
    "races": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::breed.breed",
      "mappedBy": "laboratoires"
    },
    "laboratoireAllie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::laboratory.laboratory"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "laboratoires"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
