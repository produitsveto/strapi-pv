{
  "kind": "collectionType",
  "collectionName": "laboratories",
  "info": {
    "singularName": "laboratory",
    "pluralName": "laboratories",
    "displayName": "Laboratoire",
    "description": "Laboratoire / Marque (Virbac, Elanco…)"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "shortDescription": {
      "type": "text",
      "maxLength": 250,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "laboratories"
    },
    "species": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species",
      "mappedBy": "laboratories"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
