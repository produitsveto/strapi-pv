{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Produit"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "medusaId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "handle": {
      "type": "string"
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "imagePrincipale": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "carrousel": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "descriptionEtendue": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "modeEmploi": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "precautions": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "notice": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["files"]
    },
    "formeGalenique": {
      "type": "string"
    },
    "synonymes": {
      "type": "text"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "laboratoire": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::laboratory.laboratory"
    },
    "especes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species"
    },
    "races": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::breed.breed"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
