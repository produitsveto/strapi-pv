{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "ALL - Produit"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nomCourt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ean": {
      "type": "string",
      "unique": true,
      "regex": "^[0-9]{8,14}$"
    },
    "medusaId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "handle": {
      "type": "string"
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "shortDescription": {
      "type": "text",
      "maxLength": 250,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "carousel": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "extendedDescription": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": { "preset": "defaultHtml" },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "modeEmploi": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": { "preset": "defaultHtml" },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "precautions": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": { "preset": "defaultHtml" },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notice": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    },
    "formeGalenique": {
      "type": "enumeration",
      "enum": [
        "ampoule-buvable",
        "bande-pansement",
        "batonnet-barre-friandise",
        "baume",
        "bouchee-croquette",
        "collier",
        "collyre",
        "comprime",
        "creme-pommade-gel",
        "gelule-capsule",
        "goutte-auriculaire",
        "goutte-ophtalmique",
        "laniere-plaquette-ruban",
        "lingette-coton",
        "lotion-liquide",
        "pate-seringue",
        "pellets",
        "pipette-spot-on",
        "poudre",
        "shampooing-mousse",
        "sirop-solution-buvable",
        "solution-pour-inhalation",
        "spray-diffuseur-fogger"
      ]
    },
    "synonymes": {
      "type": "text"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "laboratory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::laboratory.laboratory"
    },
    "species": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::species.species"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "products"
    },
    "suggestedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "medication": {
      "type": "component",
      "repeatable": false,
      "component": "shared.medication"
    },
    "translationMeta": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        },
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
