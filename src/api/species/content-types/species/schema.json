{
  "kind": "collectionType",
  "collectionName": "species_entries",
  "info": {
    "singularName": "species",
    "pluralName": "species-entries",
    "displayName": "Espèce",
    "description": "Espèce cible (chien, chat, cheval…)"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "visibilite": {
      "type": "boolean",
      "default": true
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "marketingBanner": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "featuredProducts": {
      "type": "component",
      "repeatable": true,
      "component": "deals.featured-product"
    },
    "parentSpecies": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::species.species",
      "inversedBy": "childSpecies"
    },
    "childSpecies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::species.species",
      "mappedBy": "parentSpecies"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "species"
    },
    "laboratories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::laboratory.laboratory",
      "inversedBy": "species"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "species"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
